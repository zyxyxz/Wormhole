<view class="weui-navigation-bar {{extClass}}">
  <view class="weui-navigation-bar__inner {{ios ? 'ios' : 'android'}}" style="color: {{color}}; background: {{background}}; {{displayStyle}}; {{innerPaddingRight}}; {{safeAreaTop}};">

    <!-- 左侧按钮 -->
    <view class="weui-navigation-bar__left" style="{{leftWidth}};">
      <block wx:if="{{back || homeButton}}">
        <view class="navbar-actions {{back && homeButton ? 'navbar-actions--combo' : 'navbar-actions--single'}}">
          <view
            wx:if="{{back}}"
            bindtap="back"
            class="navbar-actions__btn"
            hover-class="navbar-actions__btn--active"
            hover-stay-time="100"
            aria-role="button"
            aria-label="返回"
          >
            <view class="navbar-actions__icon navbar-actions__icon--back"></view>
          </view>
          <view
            wx:if="{{back && homeButton}}"
            class="navbar-actions__divider"
            aria-hidden="true"
          ></view>
          <view
            wx:if="{{homeButton}}"
            bindtap="home"
            class="navbar-actions__btn"
            hover-class="navbar-actions__btn--active"
            hover-stay-time="100"
            aria-role="button"
            aria-label="主页"
          >
            <view class="navbar-actions__icon navbar-actions__icon--home"></view>
          </view>
        </view>
      </block>
      <block wx:else>
        <slot name="left"></slot>
      </block>
    </view>

    <!-- 标题 -->
    <view class='weui-navigation-bar__center'>
      <view wx:if="{{loading}}" class="weui-navigation-bar__loading" aria-role="alert">
        <view
          class="weui-loading"
          aria-role="img"
          aria-label="加载中"
        ></view>
      </view>
      <block wx:if="{{title}}">
        <text>{{title}}</text>
      </block>
      <block wx:else>
        <slot name="center"></slot>
      </block>
    </view>

    <!-- 右侧留空 -->
    <view class='weui-navigation-bar__right'>
      <slot name="right"></slot>
    </view>
  </view>
</view>
