page {
  background: var(--bg);
}

.search-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg);
}

.search-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  flex: 1;
  position: relative;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 14rpx 56rpx 14rpx 28rpx;
  box-sizing: border-box;
}

.search-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.4;
}

.search-placeholder {
  color: var(--text-muted);
}

.clear-btn {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.25);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--primary-strong);
  padding: 8rpx 6rpx;
}

.search-results {
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.result-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.result-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(20, 184, 166, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-avatar-img {
  width: 100%;
  height: 100%;
}

.result-avatar-fallback {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-strong);
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.result-alias {
  color: var(--text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.result-time {
  flex-shrink: 0;
}

.result-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
  word-break: break-word;
}

.empty-wrap {
  padding: 80rpx 24rpx;
}
