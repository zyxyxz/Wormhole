page {
  overflow: hidden;
}

.discover-page {
  min-height: calc(100vh - 44px - env(safe-area-inset-top));
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg);
}

.intro-card {
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--border);
  background:
    radial-gradient(circle at top right, rgba(94, 234, 212, 0.2), transparent 56%),
    linear-gradient(145deg, var(--surface), rgba(15, 23, 42, 0.02));
  box-shadow: var(--shadow-soft);
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.intro-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.space-code {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.14);
  color: var(--primary-strong);
  font-size: 22rpx;
}

.section-title {
  margin-top: 28rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.app-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.app-card {
  min-height: 184rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  padding: 18rpx 12rpx;
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.app-card.notebook .app-icon {
  background: rgba(34, 211, 238, 0.16);
}

.app-card.vault .app-icon {
  background: rgba(99, 102, 241, 0.16);
}

.app-card.wallet .app-icon {
  background: rgba(20, 184, 166, 0.16);
}

.app-card.activity .app-icon {
  background: rgba(14, 165, 233, 0.16);
}

.app-card.emoji .app-icon {
  background: rgba(245, 158, 11, 0.16);
}

.app-card.search .app-icon {
  background: rgba(168, 85, 247, 0.16);
}

.app-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.app-name {
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-desc {
  max-width: 100%;
  font-size: 22rpx;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
