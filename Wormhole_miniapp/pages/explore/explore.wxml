<navigation-bar title="发现" back="{{false}}" home-button="{{true}}" bind:home="goHome" background="{{themeNavBg}}" color="{{themeNavText}}" />
<view class="discover-page theme-root {{themeClass}}">
  <view class="intro-card">
    <view class="intro-title">空间工具集合</view>
    <view class="intro-desc">把非高频功能收拢到一个入口，聊天和动态保持轻量。</view>
    <view wx:if="{{spaceCode}}" class="space-code">当前空间号：{{spaceCode}}</view>
  </view>

  <view class="section-title">应用</view>
  <view class="app-grid">
    <view class="app-card notebook" bindtap="openNotebook">
      <view class="app-icon">📝</view>
      <view class="app-name">笔记</view>
      <view class="app-desc">共享文档</view>
    </view>

    <view class="app-card vault" bindtap="openVault">
      <view class="app-icon">🔐</view>
      <view class="app-name">保密柜</view>
      <view class="app-desc">端到端加密</view>
    </view>

    <view class="app-card wallet" bindtap="openWallet">
      <view class="app-icon">💳</view>
      <view class="app-name">钱包</view>
      <view class="app-desc">余额交易</view>
    </view>

    <view class="app-card activity" bindtap="openActivity">
      <view class="app-icon">💬</view>
      <view class="app-name">互动提醒</view>
      <view class="app-desc">点赞评论</view>
    </view>

    <view class="app-card emoji" bindtap="openEmojiDiary">
      <view class="app-icon">📅</view>
      <view class="app-name">Emoji日记</view>
      <view class="app-desc">每日状态</view>
    </view>

    <view class="app-card search" bindtap="openSearch">
      <view class="app-icon">🔍</view>
      <view class="app-name">搜索消息</view>
      <view class="app-desc">全文检索</view>
    </view>
  </view>
</view>
