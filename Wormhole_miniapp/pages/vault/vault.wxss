page {
  overflow: hidden;
}

.vault-page {
  height: calc(100vh - 44px - constant(safe-area-inset-top));
  height: calc(100vh - 44px - env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: var(--bg);
  color: var(--text);
}

.vault-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding: 22rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--border);
  background: linear-gradient(145deg, var(--surface), rgba(20, 184, 166, 0.08));
  box-shadow: var(--shadow-soft);
}

.hero-icon {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 184, 166, 0.16);
  font-size: 48rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--text-muted);
}

.unlock-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.unlock-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.unlock-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.pass-input {
  margin-top: 22rpx;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  background: var(--input);
  color: var(--text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.primary-btn,
.upload-btn {
  margin: 22rpx 0 0;
  height: 78rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--accent-cyan), var(--accent-green));
  color: #0f172a;
  font-weight: 700;
}

/* Subtle link, intentionally low-contrast — destructive action shouldn't compete
 * for attention with the primary unlock button. */
.forgot-link {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted, #94a3b8);
  letter-spacing: 1rpx;
  padding: 12rpx 0;
}
.forgot-link:active {
  color: var(--text, #475569);
}

.vault-toolbar {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.toolbar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.toolbar-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--text-muted);
}

.upload-btn {
  width: 160rpx;
  margin: 0;
}

.file-list {
  margin-top: 18rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.file-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.file-icon {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(96, 165, 250, 0.16);
  font-size: 38rpx;
}

.file-main {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.delete-btn,
.close-btn {
  flex: 0 0 auto;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  color: var(--text-muted);
  background: transparent;
}

.video-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.72);
}

.video-panel {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--surface);
}

.video-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: var(--text);
}

.video-player {
  width: 100%;
  height: 420rpx;
  background: #000;
}
